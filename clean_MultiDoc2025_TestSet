# Dataset: https://huggingface.co/datasets/Anonymous-Team-HC-RAG/Multi-doc-2025
# Output: data/processed/multidoc_test_2023.json + .csv
# Purpose: 2023-only TEST set. The original split for train/val/test will be merged for the financial RAG checker.
#          The knowledge base is data/processed/kaggle_clean.csv (context, ticker, year).
#          Cross check with base in Kaggle cleaned data to ensure test set is cross checked.

import json
import os
import re
from pathlib import Path

import pandas as pd
from huggingface_hub import snapshot_download

# ---------------------------------------------------------------------------
# settings
# ---------------------------------------------------------------------------

HF_REPO = "Anonymous-Team-HC-RAG/Multi-doc-2025"
RAW_DIR = Path("data/raw/multidoc2025")
OUT_DIR = Path("data/processed")
KAGGLE_CLEAN = OUT_DIR / "kaggle_clean.csv"

TARGET_YEAR = 2023

# True  -> keep a row only if year == 2023 AND every year in `years_required` is 2023 the answer can be found in the 2023 filing alone.
# False -> keep every row whose primary `year` is 2023, even if it also needs 2022/2024.
STRICT_2023_ONLY = True

# True -> also drop test rows whose company(ies) have no 2023 passages in kaggle_clean.csv (those questions can't be answered by your knowledge base).
DROP_UNCOVERED = False

# Columns used to cross-check the year -> deleted. The primary `year` column stays (= 2023 only).
YEAR_CHECK_COLS = ["years_required", "is_cross_year"]

SPLIT_NAMES = {"train", "val", "validation", "test"}

#------------------------------------
# download (skipped if the files are already there)
#------------------------------------

def find_split_files():
    return sorted(
        p for p in RAW_DIR.rglob("*.json") 
        if p.stem.lower() in SPLIT_NAMES and ".cache" not in p.parts
    )

if not find_split_files():
    RAW_DIR.mkdir(parents=True, exist_ok=True)
    snapshot_download(
        repo_id=HF_REPO,
        repo_type="dataset",
        allow_patterns=["*.json"],
        local_dir=str(RAW_DIR),
    )

files = find_split_files()
print("Split files found:", [str(f) for f in files])
assert files, "No train/val/test json split files found, check repo layout on Huggingface."


#--------------------------------------
# Merge the train / validation / test into one table and remove original split created on Huggingface
#----------------------------------------------------------------------------------------------------------

frames = []

for f in files:
    with open(f, encoding = "utf-8") as fh:
        part = pd.DataFram(json.laod(fh))
    print(f" {f.name}: {part.shape}")
    frames.append(part)

raw = pd.concat(frames, ignore_index = True)
print("Merged raw shape:", raw.shape)
print(raw.columns.tolist())

if len(raw) != 2327:
    print(f"Warning: dataset card says 2,327 roaw but found {len(raw)}")
assert raw["id"].is_unique, "Duplicate ids after merging splits"

#-----------------------------------------------
# keep only the 2023 year rows and drop the rest
#------------------------------------------------

def clean_text(s: str) -> str:
    """Collapse whitespace/newlines and trim."""
    return re.sub(r"\s+", " ", str(s)).strip()

df = raw.copy()
df["year"] = pd.to_numeric(df["year"], errors="coerce").astype("Int64")

print("Rows per year before filtering:", 
    df["year"].value_counts().to_dict())

before = len(df)
df = df[df["year"] == TARGET_YEAR]
print(f"Dropped {before - len(df)} rows whose primary year isnot from {TARGET_YEAR}")

if STRICT_2023_ONLY:
    def only_target_year(ys):
        return(
            isinstance(ys, list) 
            and len(ys) > 0 
            and all(str(y) == str(TARGET_YEAR) for y in ys)
        )

    before = len(df)
    df = df[df["years_required"].map(only_target_year)]
    print(f"Dropped {before - len(df)} rows that also need another fiscal year")

#-------------------------------------------
# Delete the year cross-check columns, keep the true/false flags
#--------------------------------------------

df = df.drop(columns=[c for c in YEAR_CHECK_COLS if c in df.columns])

bool_cols = ["is_cross_doc", "is_hybrid_modal", "requires_calculation"]
for c in bool_cols:
    df[c] = df[c].astype(bool)

df["question"] = df["question"].map(clean_text)
df["answer"] = df["answer"].map(clean_text)
df["company"] = df["company"].astype(str).str.strip().str.upper()
df["companies"] = df["companies"].map(lambda cs: [str(c).strip().upper() for c in cs])

before = len(df)
df = df.drop_duplicates(subset = ["question", "answer", "company", "year"]).reset_index(drop = True)
print(f"Dropped {before - len(df)} duplicate questions")

#-------------------------------------------
# Coverage check against the cleaned Kaggle knowledge base
#--------------------------------------------

if KAGGLE_CLEAN.exists():
    kg = pd.read_csv(KAGGLE_CLEAN)
    covered = set(kg.loc[kg["year"] == TARGET_YEAR, "ticker"].astype(str).str.upper())
    
    has_docs = df["company"].map(lambda cs: all (c in covered for c in cs)) 
    print(f"Test rows fully covered by Kaggle knowledge base {TARGET_YEAR} passages: {int(has_docs.sum())} / {len(df)}")
    
    missing = sorted({c for cs in df.loc[~has_docs, "companies"] for c in cs if c not in covered})
    print("Tickers needed by the test set but missing from Kaggle knowledge base:", missing)

    if DROP_UNCOVERED:
        df = df[has_docs].reset_index(drop = True)
        print("Dropped uncovered rows. New shape:", df.shape)

else:
    print (f"(Skipping coverage check: {KAGGLE_CLEAN} not found - run Kaggle cleaning script first)")

    